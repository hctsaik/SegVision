{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segvision.local/schemas/checkpoint.schema.json",
  "title": "SegVision Task Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "run_id", "task_graph_sha256", "checkpoint_id", "task_id", "dependency_checkpoints", "source_revision", "file_tree_sha256", "owned_file_hashes", "evidence_sha256", "artifact_hashes", "commit_id", "patch_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"const": "build-segvision-v1"},
    "run_id": {"type": "string", "pattern": "^sv-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "task_graph_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_id": {"type": "string", "minLength": 3},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "dependency_checkpoints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_revision": {"type": ["string", "null"]},
    "file_tree_sha256": {"$ref": "#/$defs/sha256"},
    "owned_file_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "commit_id": {"type": ["string", "null"]},
    "patch_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "anyOf": [{"required": ["commit_id"], "properties": {"commit_id": {"type": "string", "minLength": 7}}}, {"required": ["patch_sha256"], "properties": {"patch_sha256": {"type": "string"}}}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}
}
