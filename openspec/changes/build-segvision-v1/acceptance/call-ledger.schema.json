{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segvision.local/schemas/call-ledger.schema.json",
  "title": "SegVision Backend CV and Filesystem Call Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "calls"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^sv-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "calls": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sequence", "monotonic_ns", "component", "operation", "session_id", "revision", "input_sha256", "output_sha256", "status", "details"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "monotonic_ns": {"type": "integer", "minimum": 0}, "component": {"enum": ["backend", "cv", "filesystem", "network_audit"]}, "operation": {"type": "string", "minLength": 1}, "session_id": {"type": ["string", "null"]}, "revision": {"type": ["integer", "null"], "minimum": 1}, "input_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}, "output_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}, "status": {"enum": ["succeeded", "failed", "cancelled", "stale_rejected"]}, "details": {"type": "object"}}}}
  }
}
