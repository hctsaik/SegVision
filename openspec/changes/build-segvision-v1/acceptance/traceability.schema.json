{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segvision.local/schemas/traceability.schema.json",
  "title": "SegVision Normative Scenario Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "specs_sha256", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"const": "build-segvision-v1"},
    "specs_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "SHA-256 over UTF-8 bytes of every specs/*/spec.md file, sorted by POSIX relative path, each prefixed by its path and a newline."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "requirement_id",
          "scenario_id",
          "scenario_title",
          "planned_test_id",
          "planned_test_target",
          "test_level",
          "e2e_case_ids",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "capability": {"type": "string", "minLength": 2},
          "requirement_id": {"type": "string", "pattern": "^[A-Z]{3}-R[0-9]{3}$"},
          "scenario_id": {"type": "string", "pattern": "^[A-Z]{3}-R[0-9]{3}-S[0-9]{2}$"},
          "scenario_title": {"type": "string", "minLength": 3},
          "planned_test_id": {"type": "string", "pattern": "^T-[A-Z]{3}-R[0-9]{3}-S[0-9]{2}$"},
          "planned_test_target": {"type": "string", "pattern": "^tests/.+\\.py::test_[a-z0-9_]+$"},
          "test_level": {"enum": ["unit", "integration", "gui", "e2e", "packaging", "governance", "domain"]},
          "e2e_case_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}, "uniqueItems": true},
          "status": {"enum": ["planned", "implemented", "verified", "blocked_external"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
