{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segvision.local/schemas/acceptance-profile.schema.json",
  "title": "SegVision Frozen Acceptance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "change_id", "clock", "functional", "geometry", "performance", "real_backend_regression", "storage", "domain_validation", "offline_release"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"const": "segvision-v1-default"},
    "change_id": {"const": "build-segvision-v1"},
    "clock": {
      "type": "object",
      "required": ["kind", "annotation_start_event", "annotation_end_event", "review_end_event", "deadline_ms", "deadline_operator", "roi_relock_resets_timer", "invalid_accept_resets_or_stops_timer"],
      "properties": {
        "kind": {"const": "monotonic"},
        "annotation_start_event": {"const": "first_roi_locked"},
        "annotation_end_event": {"const": "accept_validation_passed"},
        "review_end_event": {"const": "needs_review_requested"},
        "deadline_ms": {"const": 30000},
        "deadline_operator": {"const": "strictly_less_than"},
        "roi_relock_resets_timer": {"const": false},
        "invalid_accept_resets_or_stops_timer": {"const": false}
      },
      "additionalProperties": false
    },
    "functional": {"type": "object", "additionalProperties": false, "required": ["mandatory_pass_rate", "allowed_skips", "allowed_xfails", "allowed_flaky_retries", "allowed_stale_overwrites", "max_candidates", "sam_proposal_encoder_calls", "cv_direct_encoder_calls", "sam_refine_encoder_delta"], "properties": {"mandatory_pass_rate": {"const": 1.0}, "allowed_skips": {"const": 0}, "allowed_xfails": {"const": 0}, "allowed_flaky_retries": {"const": 0}, "allowed_stale_overwrites": {"const": 0}, "max_candidates": {"const": 3}, "sam_proposal_encoder_calls": {"const": 1}, "cv_direct_encoder_calls": {"const": 0}, "sam_refine_encoder_delta": {"const": 0}}},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["padding_fraction", "rectangle_convention", "round_trip_max_error_px", "candidate_mask_dtype", "accepted_png_values"], "properties": {"padding_fraction": {"const": 0.1}, "rectangle_convention": {"const": "half_open_xyxy"}, "round_trip_max_error_px": {"const": 1}, "candidate_mask_dtype": {"const": "bool"}, "accepted_png_values": {"const": [0, 255]}}},
    "performance": {"type": "object", "additionalProperties": false, "required": ["reference_machine_manifest_required", "overlay_brush_p95_ms", "cached_refine_p95_ms", "scripted_supported_case_decision_ms", "required_percentiles", "cold_and_warm_reported_separately", "peak_ram_required"], "properties": {"reference_machine_manifest_required": {"const": true}, "overlay_brush_p95_ms": {"const": {"value": 100, "operator": "strictly_less_than", "hard_gate": true, "min_samples": 1000}}, "cached_refine_p95_ms": {"const": {"value": 1000, "operator": "less_than_or_equal", "hard_gate": false, "classification": "prd_best_effort_target", "min_samples": 30}}, "scripted_supported_case_decision_ms": {"const": {"value": 30000, "operator": "strictly_less_than", "hard_gate": true}}, "required_percentiles": {"const": [50, 90, 95]}, "cold_and_warm_reported_separately": {"const": true}, "peak_ram_required": {"const": true}}},
    "real_backend_regression": {"type": "object", "additionalProperties": false, "required": ["fixture_manifest_required", "minimum_fixture_count", "candidate_count_must_match", "selected_mask_iou_minimum", "maximum_boundary_displacement_px", "provider_score_absolute_tolerance", "call_ledger_must_match", "checkpoint_and_runtime_hashes_must_match"], "properties": {"fixture_manifest_required": {"const": true}, "minimum_fixture_count": {"const": 3}, "candidate_count_must_match": {"const": true}, "selected_mask_iou_minimum": {"const": 0.995}, "maximum_boundary_displacement_px": {"const": 1}, "provider_score_absolute_tolerance": {"const": 0.0001}, "call_ledger_must_match": {"const": true}, "checkpoint_and_runtime_hashes_must_match": {"const": true}}},
    "storage": {"type": "object", "additionalProperties": false, "required": ["partial_pairs_accepted", "hash_mismatches_accepted", "review_items_returned_by_training_loader", "accepted_pairs_reload_rate", "default_overwrite"], "properties": {"partial_pairs_accepted": {"const": 0}, "hash_mismatches_accepted": {"const": 0}, "review_items_returned_by_training_loader": {"const": 0}, "accepted_pairs_reload_rate": {"const": 1.0}, "default_overwrite": {"const": false}}},
    "domain_validation": {"type": "object", "additionalProperties": false, "required": ["minimum_representative_images", "minimum_independent_gold_images", "minimum_valid_accepted_images", "minimum_valid_accept_rate", "accepted_conditional_within_30_rate", "all_presented_within_30_accept_rate_minimum", "maximum_needs_review_rate", "maximum_timeout_rate", "maximum_unresolved_rate", "maximum_wrong_accept_rate", "median_boundary_f1_minimum", "per_image_boundary_f1_minimum", "boundary_tolerance", "boundary_metric", "independent_gold_required", "independent_human_review_required", "real_annotator_workflow_required", "minimum_independently_reviewed_accepted_images", "minimum_training_usable_rate", "wrong_accept_denominator", "synthetic_data_may_satisfy_domain_gate"], "properties": {"minimum_representative_images": {"const": 100}, "minimum_independent_gold_images": {"const": 30}, "minimum_valid_accepted_images": {"const": 90}, "minimum_valid_accept_rate": {"const": 0.9}, "accepted_conditional_within_30_rate": {"const": 1.0}, "all_presented_within_30_accept_rate_minimum": {"const": 0.9}, "maximum_needs_review_rate": {"const": 0.1}, "maximum_timeout_rate": {"const": 0.0}, "maximum_unresolved_rate": {"const": 0.0}, "maximum_wrong_accept_rate": {"const": 0.0}, "median_boundary_f1_minimum": {"const": 0.95}, "per_image_boundary_f1_minimum": {"const": 0.9}, "boundary_tolerance": {"const": {"kind": "max_pixels_or_diagonal_fraction", "pixels": 2, "image_diagonal_fraction": 0.002}}, "boundary_metric": {"const": {"algorithm_id": "segvision-symmetric-boundary-f1-v1", "input": "full_image_bool_masks", "boundary_extraction": "foreground_pixels_with_any_8_neighbor_background_or_outside_image", "matching_distance": "symmetric_euclidean_within_tolerance", "both_empty_f1": 1.0, "one_empty_f1": 0.0, "aggregation": "per_image_then_median_over_independent_gold_set"}}, "independent_gold_required": {"const": true}, "independent_human_review_required": {"const": true}, "real_annotator_workflow_required": {"const": true}, "minimum_independently_reviewed_accepted_images": {"const": 30}, "minimum_training_usable_rate": {"const": 1.0}, "wrong_accept_denominator": {"const": "all_independently_reviewed_accepted_images"}, "synthetic_data_may_satisfy_domain_gate": {"const": false}}},
    "offline_release": {"type": "object", "additionalProperties": false, "required": ["network_required", "login_required", "cuda_required", "clean_windows_install_required", "paths_with_spaces_and_unicode_required", "lockfile_required", "sbom_required", "third_party_notices_required", "approved_model_manifest_required"], "properties": {"network_required": {"const": false}, "login_required": {"const": false}, "cuda_required": {"const": false}, "clean_windows_install_required": {"const": true}, "paths_with_spaces_and_unicode_required": {"const": true}, "lockfile_required": {"const": true}, "sbom_required": {"const": true}, "third_party_notices_required": {"const": true}, "approved_model_manifest_required": {"const": true}}}
  }
}
