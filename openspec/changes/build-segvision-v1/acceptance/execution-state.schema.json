{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segvision.local/schemas/execution-state.schema.json",
  "title": "SegVision Autonomous Execution State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "run_id",
    "task_graph_sha256",
    "source",
    "target_release_class",
    "project_state",
    "tasks",
    "open_blockers",
    "latest_verdict",
    "started_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"const": "build-segvision-v1"},
    "run_id": {"type": "string", "pattern": "^sv-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "task_graph_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "file_tree_sha256", "dirty_paths"],
      "properties": {
        "revision": {"type": ["string", "null"]},
        "file_tree_sha256": {"$ref": "#/$defs/sha256"},
        "dirty_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "target_release_class": {"enum": ["engineering", "domain"]},
    "project_state": {"enum": ["in_progress", "complete", "implementation_complete_release_blocked", "failed"]},
    "latest_verdict": {
      "type": ["string", "null"],
      "enum": [
        null,
        "PASS_ENGINEERING",
        "PASS_DOMAIN_VALIDATED",
        "FAIL",
        "BLOCKED_EXTERNAL_INPUT",
        "BLOCKED_LICENSE",
        "BLOCKED_REFERENCE_HARDWARE"
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "state", "dependencies", "attempt_count", "checkpoint_id", "evidence_refs", "blocker_ref", "reason", "updated_at"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "state": {
            "enum": [
              "pending",
              "runnable",
              "running",
              "passed",
              "failed_retryable",
              "blocked_external_input",
              "blocked_license",
              "blocked_reference_hardware",
              "rejected"
            ]
          },
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}, "uniqueItems": true},
          "attempt_count": {"type": "integer", "minimum": 0, "maximum": 3},
          "checkpoint_id": {"type": ["string", "null"], "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "blocker_ref": {"type": ["string", "null"], "pattern": "^BLK-[A-Z0-9-]+$"},
          "reason": {"type": ["string", "null"], "minLength": 3},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"enum": ["pending", "runnable"]}}, "required": ["state"]},
            "then": {"properties": {"attempt_count": {"const": 0}, "checkpoint_id": {"type": "null"}, "blocker_ref": {"type": "null"}}}
          },
          {
            "if": {"properties": {"state": {"const": "running"}}, "required": ["state"]},
            "then": {"properties": {"attempt_count": {"minimum": 1}, "checkpoint_id": {"type": "null"}, "blocker_ref": {"type": "null"}, "reason": {"type": "string"}}}
          },
          {
            "if": {"properties": {"state": {"const": "passed"}}, "required": ["state"]},
            "then": {"properties": {"attempt_count": {"minimum": 1}, "checkpoint_id": {"type": "string"}, "evidence_refs": {"minItems": 1}, "blocker_ref": {"type": "null"}, "reason": {"type": "string"}}}
          },
          {
            "if": {"properties": {"state": {"const": "failed_retryable"}}, "required": ["state"]},
            "then": {"properties": {"attempt_count": {"minimum": 1, "maximum": 2}, "checkpoint_id": {"type": "null"}, "evidence_refs": {"minItems": 1}, "blocker_ref": {"type": "null"}, "reason": {"type": "string"}}}
          },
          {
            "if": {"properties": {"state": {"enum": ["blocked_external_input", "blocked_license", "blocked_reference_hardware"]}}, "required": ["state"]},
            "then": {"properties": {"checkpoint_id": {"type": "null"}, "evidence_refs": {"minItems": 1}, "blocker_ref": {"type": "string"}, "reason": {"type": "string"}}}
          },
          {
            "if": {"properties": {"state": {"const": "rejected"}}, "required": ["state"]},
            "then": {"properties": {"attempt_count": {"minimum": 1}, "checkpoint_id": {"type": "null"}, "evidence_refs": {"minItems": 1}, "reason": {"type": "string"}}}
          }
        ]
      }
    },
    "open_blockers": {"type": "array", "items": {"type": "string", "pattern": "^BLK-[A-Z0-9-]+$"}, "uniqueItems": true},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"project_state": {"const": "in_progress"}}, "required": ["project_state"]},
      "then": {"properties": {"latest_verdict": {"type": "null"}}}
    },
    {
      "if": {"properties": {"project_state": {"const": "complete"}}, "required": ["project_state"]},
      "then": {"properties": {"latest_verdict": {"enum": ["PASS_ENGINEERING", "PASS_DOMAIN_VALIDATED"]}, "open_blockers": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"project_state": {"const": "implementation_complete_release_blocked"}}, "required": ["project_state"]},
      "then": {"properties": {"latest_verdict": {"enum": ["BLOCKED_EXTERNAL_INPUT", "BLOCKED_LICENSE", "BLOCKED_REFERENCE_HARDWARE"]}, "open_blockers": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"project_state": {"const": "failed"}}, "required": ["project_state"]},
      "then": {"properties": {"latest_verdict": {"const": "FAIL"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  }
}
