{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segvision.local/desktop-protocol/labels.schema.json",
  "title": "SegVisionProjectLabels",
  "type": "object",
  "required": ["labels"],
  "properties": {
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "shortcut", "labelme_name"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "display_name": {"type": "string", "minLength": 1},
          "shortcut": {"type": "string", "minLength": 1, "maxLength": 2},
          "labelme_name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
